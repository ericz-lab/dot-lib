{
  "name": "dot-lib",
  "version": "1.0.0",
  "description": "Self-hosted e-book reader backed by Cloudflare R2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite web",
    "build": "vite build web && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "hono": "^4.6.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "concurrently": "^9.0.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
